{
    "background": {
        "type": "image",
        "position": [ 0, 0 ],
        "file": "/interface/scripted/localanimatorgui/body_itemSpark.png",
        "centered": false
    },
    "falseImage": {
        "type": "button",
        "base": "/interface/scripted/localanimatorgui/body_false.png",
        "zlevel": 3,
        "visible": false,
        "callback": "null"
    },
    "sparkRadiusTitle": {
        "type": "label",
        "position": [ 62, 219 ],
        "hAnchor": "mid",
        "vAnchor": "mid",
        "wrapWidth": 105,
        "fontSize": 8,
        "color": "orange",
        "value": "Item spark radius"
    },
    "sparkRadiusLabel": {
        "type": "label",
        "position": [ 73, 205 ],
        "hAnchor": "mid",
        "vAnchor": "mid",
        "wrapWidth": 105,
        "fontSize": 8,
        "value": "0"
    },
    "radiusUP": {
        "type": "button",
        "base": "/interface/smallarrowbuttons.png:addb",
        "hover": "/interface/smallarrowbuttons.png:addh",
        "press": "/interface/smallarrowbuttons.png:addh",
        "data": {
            "localAnimator": {
                "option": "spark_radius",
                "count": 5,
                "countMax": 100
            }
        },
        "callback": "optionUP",
        "position": [ 3, 198 ]
    },
    "radiusDOWN": {
        "type": "button",
        "base": "/interface/smallarrowbuttons.png:remb",
        "hover": "/interface/smallarrowbuttons.png:remh",
        "press": "/interface/smallarrowbuttons.png:remh",
        "data": {
            "localAnimator": {
                "option": "spark_radius",
                "count": 5,
                "countMin": 10
            }
        },
        "callback": "optionDOWN",
        "position": [ 18, 198 ]
    },
