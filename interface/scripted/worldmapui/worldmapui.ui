{   
    "gui": {
        "background": {
            "type": "background",
            "fileHeader": "/interface/scripted/worldmapui/header.png",
            "fileBody": "/interface/scripted/worldmapui/body.png",
            "fileFooter": "/interface/scripted/worldmapui/footer.png"
        },
        // "close": {
