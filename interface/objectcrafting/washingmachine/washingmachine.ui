{
    "gui": {
        "background": {
            "type": "background",
            "fileHeader": "/interface/objectcrafting/washingmachine/header.png",
            "fileBody": "/interface/objectcrafting/washingmachine/body.png",
            "fileFooter": "/interface/objectcrafting/washingmachine/footer.png"
        },
        //! Buttons--------------------------------------------------------------------------------
        "close": {
            "type": "button",
            "base": "/interface/close.png:1", 
            "hover": "/interface/close.png:2", 
            "pressed": "/interface/close.png:3",
            "position": [ 213, 150 ]
        },
        "toggleCrafting": {
            "type": "button",
            "position": [ 5, 33 ],
            "base": "/interface/objectcrafting/craftbutton.png:1",
            "hover": "/interface/objectcrafting/craftbutton.png:2",
            "caption": "Start",
            "callback": "trigger"
        },
        "recipes": {
            "type": "button",
            "position": [ 5, 18 ],
            "base": "/interface/objectcrafting/craftbutton.png:1",
            "hover": "/interface/objectcrafting/craftbutton.png:2",
            "caption": "Recipes",
            "callback": "recipelist"
        },
        //! Labels---------------------------------------------------------------------------------
        "InputTitle": {
            "type": "label",
            "position": [ 100, 131 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Input slots"
        },      
        "specialTitle": {
            "type": "label",
            "position": [ 100, 56 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Special slot"
        },     
        "outputTitle": {
            "type": "label",
            "position": [ 166, 131 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Output"
        },  
        "battery": {
            "type": "label",
            "position": [ 36, 74 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Energy",
            "color": "#00CDF9"
        },
        "batterytext": {
            "type": "label",
            "position": [ 36, 64 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "color": "#00CDF9"
        },
        "progress": {
            "type": "label",
            "position": [ 36, 120 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Progress",
            "color": "orange"
        },
        "core_upgrade": {
            "type": "itemslot",
            "zlevel": 2,
            "position": [ 202, 107 ],
            "callback": "moduleswap",
            "rightClickCallback": "null",
            "showRarity": false,
            "showBackingImageWhenEmpty": true,
            "showBackingImageWhenFull": true,
            "backingImage":"/interface/objectcrafting/moduleSlot.png:1"
        },
        "efficiency_upgrade": {
            "type": "itemslot",
            "zlevel": 2,
            "position": [ 202, 88 ],
            "callback": "moduleswap",
            "rightClickCallback": "null",
            "showRarity": false,
            "showBackingImageWhenEmpty": true,
            "showBackingImageWhenFull": true,
            "backingImage":"/interface/objectcrafting/moduleSlot.png:2"
        },
        "acceleration_upgrade": {
            "type": "itemslot",
            "zlevel": 2,
            "position": [ 202, 69 ],
            "callback": "moduleswap",
            "rightClickCallback": "null",
            "showRarity": false,
            "showBackingImageWhenEmpty": true,
            "showBackingImageWhenFull": true,
            "backingImage":"/interface/objectcrafting/moduleSlot.png:3"
        },
        //! ItemGridItems--------------------------------------------------------------------------
        "itemGrid": {
            "type": "itemgrid",
            "position": [ 72, 69 ],
            "dimensions": [ 3, 3 ],
            "showDurability": false,
            "spacing": [ 19, 19 ],
            "backingImage": "/interface/inventory/empty.png"
        },
        "itemGrid2": {
            "type": "itemgrid",
            "slotOffset": 9,
            "position": [ 72, 32 ],
            "dimensions": [ 3, 1 ],
            "showDurability": true,
            "spacing": [ 19, 19 ],
            "backingImage":"/interface/objectcrafting/specialslot.png"
        },
        "outputItemGrid": {
            "type": "itemgrid",
            "slotOffset": 12,
            "position": [ 137, 31 ],
            "showDurability": false,
            "dimensions": [ 3, 5 ],
            "spacing": [ 19, 19 ],
            "backingImage": "/interface/inventory/empty.png"
        },
        //! ItemSlotItems--------------------------------------------------------------------------
        
        "modulelockerTitle": {
            "type": "label",
            "wrapWidth": 50,
            "zlevel": 11,
            "position": [ 35, 110 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Upgrade to unlock modules"
        },
        //! progressBar----------------------------------------------------------------------------
        "progressBar": {
            "zlevel": 7,
            "type": "progress",
            "position": [ 8, 107 ],
            "background": "/interface/objectcrafting/bars.png:empty",
            "progressSet": {
                "inner": "/interface/objectcrafting/bars.png:6",
                "type": "repeat"
            },
            "direction": "horizontal"
        },
        "energyBar": {
            "zlevel": 7,
            "type": "progress",
            "position": [ 8, 51 ],
            "background": "/interface/objectcrafting/bars.png:empty",
            "progressSet": {
                "inner": "/interface/objectcrafting/bars.png:3",
                "type": "repeat"
            },
            "direction": "horizontal"
        }
    },
    "scriptWidgetCallbacks": [
        "trigger",
        "pourout",
        "moduleswap",
        "recipelist"
    ],
    "scriptDelta": 5,
    "scripts": [
        "/scripts/multicraft/trigger.lua"
    ]
}
