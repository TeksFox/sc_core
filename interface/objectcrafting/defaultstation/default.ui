{
    "gui": {
        "background": {
            "type": "background",
            "fileHeader": "/interface/objectcrafting/chemicalextractor/header.png",
            "fileBody": "/interface/objectcrafting/chemicalextractor/body.png",
            "fileFooter": "/interface/objectcrafting/chemicalextractor/footer.png"
        },
        //! Buttons--------------------------------------------------------------------------------
        "close": {
            "type": "button",
            "base": "/interface/close.png:1", 
            "hover": "/interface/close.png:2", 
            "pressed": "/interface/close.png:3",
            "position": [ 191, 161 ]
        },
        "toggleCrafting": {
            "type": "button",
            "position": [ 8, 59 ],
            "base": "/interface/objectcrafting/craftbutton.png:1",
            "hover": "/interface/objectcrafting/craftbutton.png:2",
            "disabledImage": "/interface/objectcrafting/craftbutton.png:3",
            "caption": "Start",
            "callback": "trigger"
        },
        "recipes": {
            "type": "button",
            "position": [ 8, 43 ],
            "base": "/interface/objectcrafting/craftbutton.png:1",
            "hover": "/interface/objectcrafting/craftbutton.png:2",
            "disabledImage": "/interface/objectcrafting/craftbutton.png:3",
            "caption": "Recipes",
            "callback": "recipelist"
        },
        //! Labels---------------------------------------------------------------------------------
        "statsLabel": {
            "type": "label",
            "position": [ 38, 143 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Stats",
            "color": "orange"
        },        
        "Input1": {
            "type": "label",
            "position": [ 105, 143 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Input slots",
            "color": "orange"
        },
        "output": {
            "type": "label",
            "position": [ 170, 143 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Output",
            "color": "green"
        },
        "battery": {
            "type": "label",
            "position": [ 38, 104 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Energy",
            "fontSize": 6,
            "color": "#00CDF9"
        },
        // "batterytext": {
        //     "type": "label",
        //     "position": [ 36, 65 ],
        //     "hAnchor": "mid",
        //     "vAnchor": "mid",
        //     "fontSize": 6,
        //     "color": "#00CDF9"
        // },
        
        "progress": {
            "type": "label",
            "position": [ 38, 130 ],
            "hAnchor": "mid",
            "vAnchor": "mid",
            "value": "Progress",
            "fontSize": 6,
            "color": "orange"
        },
        //! ItemGridItems--------------------------------------------------------------------------
        "itemGrid": {
            "type": "itemgrid",
            "position": [ 77, 81 ],
            "dimensions": [ 3, 3 ],
            "spacing": [ 19, 19 ],
            "backingImage": "/interface/inventory/empty.png"
        },
        "outputItemGrid": {
            "type": "itemgrid",
            "slotOffset": 9,
            "position": [ 142, 43 ],
            "dimensions": [ 3, 5 ],
            "spacing": [ 19, 19 ],
            "backingImage": "/interface/inventory/empty.png"
        },
        //! progressBar----------------------------------------------------------------------------
        "progressBar": {
            "zlevel": 7,
            "type": "progress",
            "position": [ 9, 113 ],
            "background": "/interface/objectcrafting/bars.png:1",
            "progressSet": {
                "inner": "/interface/objectcrafting/bars.png:4",
                "type": "repeat"
            },
            "direction": "horizontal"
        },
        
        "energyBar": {
            "zlevel": 7,
            "type": "progress",
            "position": [ 9, 87 ],
            "background": "/interface/objectcrafting/bars.png:1",
            "progressSet": {
                "inner": "/interface/objectcrafting/bars.png:3",
                "type": "repeat"
            },
            "direction": "horizontal"
        }
    },
    "scriptWidgetCallbacks": [
        "trigger",
        "moduleswap",
        "recipelist"
    ],
    "scriptDelta": 5,
    "scripts": [
        "/scripts/multicraft/trigger.lua"
    ]
}


