{
    "animatedParts": {
        "stateTypes": {
            "activeState": {
                "default": "default",
                "states": {
                    "default": { "frames": 1 }
                }
            }
        },
        "parts": {
            "body": {
                "properties": { "zLevel": 1, "centered": false, "fullbright": false},
                "partStates": {
                    "activeState": {
                        "default": {
                            "properties": { "image": "<partImage>:default" }
                        }
                    }
                }
            },
            "fullbright": {
                "properties": { "zLevel": 3, "centered": false, "fullbright": true, "offset" : [ 0.375, 0.75 ] },
                "partStates": {
                    "activeState": {
                        "default": {
                            "properties": { "image": "<partImage>:default<liquid><size>" }
                        }
                    }
                }
            }
        }
    }
}