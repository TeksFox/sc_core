{
    "animatedParts": {
        "stateTypes": {
            "activeState": {
                "default": "idle",
                "states": {
                    "idle": {
                        "frames": 1,
                        "cycle": 0.5,
                        "mode": "loop"
                    },
                    "active": {
                        "frames": 3,
                        "cycle": 0.5,
                        "mode": "loop"
                    }
                }
            }
        },
        "parts": {
            "body": {
                "properties": { "zLevel": 1, "centered": false, "fullbright": false},
                "partStates": {
                    "activeState": {
                        "idle": {
                            "properties": { "image": "<part>:active.1<color_active>" }
                        },
                        "active": {
                            "properties": { "image": "<part>:active.<frame><color_active>" }
                        }
                    }
                }
            }
        }
    },
    "lights": {
        "glow": {
            "active": false,
            "color": [ 153, 153, 122 ],
            "position": [ 4.375, 1.75 ],
            "flickerPeriod": 1.0,
            "flickerMinIntensity": 0.95,
            "flickerMaxIntensity": 1.0,
            "flickerPeriodVariance": 0,
            "flickerIntensityVariance": 0
        }
    },
    "particleEmitters": {
        "bugs": {
            "emissionRate": 0.5,
            "emissionVariance": 0.3,
            "particles": [
                {
                    "offset": [ 4.375, 1.75 ],
                    "particle": {
                        "type": "ember",
                        "size": 1.0,
                        "color": [ 255, 254, 190, 255 ],
                        "destructionAction": "shrink",
                        "destructionTime": 0.5,
                        "position": [ 0.0, 0.0 ],
                        "initialVelocity": [ 0, 0 ],
                        "finalVelocity": [ -0.1, -0.1 ],
                        "approach": [ 0.65, 0.65 ],
                        "timeToLive": 5,
                        "light": [ 20, 20, 16 ],
                        "layer": "back",
                        "variance": {
                            "initialVelocity": [ 1.0, 1.0 ],
                            "finalVelocity": [ 1.0, 1.0 ],
                            "position": [ 0.5, 0.5 ]
                        }
                    }
                }
            ]
        }
    }
}