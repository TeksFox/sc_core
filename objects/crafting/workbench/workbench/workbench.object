{
    "objectName": "workbench",
    "colonyTags": [
        "crafting",
        "electronic"
    ],
    "rarity": "rare",
    "price": 1250,
    "printable": false,
    "description": "Основная станция для ручной работы!",
    "shortdescription": "^orange;Верстак^white;",
    "race": "generic",
