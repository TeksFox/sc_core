{
    "animatedParts": {
        "stateTypes": {
            "bodyState": {
                "default": "default",
                "states": {
                    "default": { "frames": 1 }
                }
            },
            "activeState": {
                "default": "idle",
                "states": {
                    "idle": {
                        "frames": 1,
                        "cycle": 1,
                        "mode": "loop",
                        "properties": {
                            "lightsOff": [ "fireglow" ]
                        }
                    },
                    "active": {
                        "frames": 4,
                        "cycle": 0.5,
                        "mode": "loop",
                        "properties": {
                            "lightsOn": [ "fireglow" ],
                            "persistentSound": "/sfx/objects/campfire.ogg",
                            "persistentSoundRangeMultiplier": 0.5
                        }
                    }
                }
            }
        },
        "parts": {
            "body": {
                "properties": { "zLevel": 1, "centered": false, "fullbright": false},
                "partStates": {
                    "bodyState": {
                        "default": {
                            "properties": { "image": "<partImage>:default" }
                        }
                    }
                }
            },
            "light": {
                "properties": { "zLevel": 2,"centered": false, "fullbright": true },
                "partStates": {
                    "activeState": {
                        "idle": {
                            "properties": { "image": "<partImage>:idle.1" }
                        },
                        "active": {
                            "properties": { "image": "<partImage>:active.<frame>" }
                        }
                    }
                }
            }
        }
    },
    "lights": {
        "fireglow": {
            "active": false,
            "position": [ 2, 1 ],
            "color": [ 153, 128, 92 ],
            "flickerPeriod": 0.3,
            "flickerMinIntensity": 0.95,
            "flickerMaxIntensity": 1,
            "flickerPeriodVariance": 0.075,
            "flickerIntensityVariance": 0.025
        }
    },
    "particleEmitters": {
        "bugs": {
            "emissionRate": 0.5,
            "emissionVariance": 0.3,
            "particles": [
                {
                    "offset": [ 4.375, 1.75 ],
                    "particle": {
                        "type": "ember",
                        "size": 1.0,
                        "color": [ 255, 254, 190, 255 ],
                        "destructionAction": "shrink",
                        "destructionTime": 0.5,
                        "position": [ 0.0, 0.0 ],
                        "initialVelocity": [ 0, 0 ],
                        "finalVelocity": [ -0.1, -0.1 ],
                        "approach": [ 0.65, 0.65 ],
                        "timeToLive": 5,
                        "light": [ 20, 20, 16 ],
                        "layer": "back",
                        "variance": {
                            "initialVelocity": [ 1.0, 1.0 ],
                            "finalVelocity": [ 1.0, 1.0 ],
                            "position": [ 0.5, 0.5 ]
                        }
                    }
                }
            ]
        },
        "upgrade": {
            "emissionRate": 0.0,
            "burstCount": 12,
            "offsetRegion": [ 0, 0, 5, 3 ],
            "particles": [
                { "particle": "dust2" },
                { "particle": "dust2" }
            ]
        }
    }
}