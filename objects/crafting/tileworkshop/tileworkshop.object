{
    "objectName": "tileworkshop",
    "colonyTags": [
        "factory",
        "crafting"
    ],
    "printable": false,
    "price": 0,
    "rarity": "common",
    "race": "generic",
    "category": "crafting",
    "description": "Basic crafting device!",
    "shortdescription": "Tile Aworkshop",
    "largeImage": "tileworkshop.png:full",
    "inventoryIcon": "icon.png",
    "orientations": [
        {
            "dualImage": "tileworkshop.png:full",
            "imagePosition": [ 0, 0 ],
            "frames": 1,
            "animationCycle": 1.0,
            "spaceScan": 0.1,
            "anchors": [ "bottom" ],
            "collision": "platform"
        }
    ],

    "animation": "tileworkshop.animation",

    "scripts": [
        "/scripts/objects/sf_object_crafting.lua",
        "/scripts/smarttubes/conduitscripts/st_crafting.lua", 
        "/scripts/objects/sf_object_colorizer.lua"
    ],
    "scriptDelta": 2,

    "interactAction": "ScriptPane",
    "interactData": "/interface/scripted/crafting/crafting.ui",
    "line": 5,
    "durationMultipler": 1.3, 
    
    "objectfilters": [ "tileworkshop", "craftingfurniture", "craftingfurniture2" ],


    "colorizer": true,
    "defaultAnimation": true,
    "animationParameters": {
        "animationParts": {
            "body": {
                "partImage": "tileworkshop.png",
                "colors": { "default": [ "sf_steel", "sf_red", "sf_bronz" ] }
            },
            "light": {
                "partImage": "tileworkshoplit.png",
                "colors": { "default": [] },
                "hide": true 
            }
        }
    },
    "connectEnabled": false,
    "outputNodes": [ [ 0, 0 ] ],
    "uiconfig": {
        "uiOpenSound": "/",
        "uiClosedSound": "/",
        "uiListSound": "/sfx/interface/clickon_success.ogg",
        "category": [
            {
                "selected": true,
                "friendlyname": "^orange;Wooden tiles",
                "category": [ "wood" ],
                "order": 1,
                "icon": "/interface/uiparts/icons/icon_list_woodtiles.png"
            },
            {
                "friendlyname": "^orange;Stone tiles",
                "category": [ "stone" ],
                "order": 2,
                "icon": "/interface/uiparts/icons/icon_list_stonetiles.png"
            },
            {
                "friendlyname": "^orange;Metal tiles",
                "category": [ "metal" ],
                "order": 3,
                "icon": "/interface/uiparts/icons/icon_list_metaltiles.png"
            },
            {
                "friendlyname": "^orange;Paper tiles",
                "category": [ "paper" ],
                "order": 4,
                "icon": "/interface/uiparts/icons/icon_list_pappertiles.png"
            },
            {
                "friendlyname": "^orange;Organic tiles",
                "category": [ "organic" ],
                "order": 5,
                "icon": "/interface/uiparts/icons/icon_list_othertiles.png"
            },
            {
                "friendlyname": "^orange;Other tiles",
                "category": [ "other" ],
                "order": 6,
                "icon": "/interface/uiparts/icons/icon_list_othertiles.png"
            }
        ]
    },
    "conduitType": "station"

}   