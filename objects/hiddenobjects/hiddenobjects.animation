{
    "animatedParts": {
        "stateTypes": {
            "defaultState": {
                "default": "default",
                "states": {
                    "default": {}
                }
            }
        },
        "parts": {
            "body": {
                "properties": {
                    "centered": false
                },
                "partStates": {
                    "defaultState": {
                        "default": {
                            "properties": {
                                "image": "<partImage>:<tag>"
                            }
                        }
                    }
                }
            }
        }
    },
    "particleEmitters": {
        "dust": {
            "emissionRate": 2,
            "emissionVariance": 0.3,
            "offsetRegion" : [0, 0, 2, 1],
            "burstCount": 20,
            "particles": [
                {
                    "particle": {
                        "type" : "animated",
                        "animation" : "/animations/shards/rockshard.animation",
                        "destructionAction" : "shrink",
                        "destructionTime" : 1,
                        "size": 0.8,
                        "fade": 0.9,
                        "position": [ 0.0, 0.0 ],
                        "initialVelocity": [ 0, 1 ],
                        "finalVelocity": [ 0, 3 ],
                        "timeToLive": 2,
                        "underwaterOnly": false,
                        "layer": "front",
                        "color": "#FFFFFF",
                        "variance": {
                            "size": 0.3,
                            "initialVelocity": [
                                0.5,
                                0.5
                            ]
                        }
                    }
                }
            ]
        }
    }
}