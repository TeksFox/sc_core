{
    "animatedParts": {
        "stateTypes": {
            "stage": {
                "default": "idle",
                "states": {
                    "idle": {
                        "frames": 8,
                        "cycle": 0.5,
                        "mode": "loop",
                        "properties": {
                            "lightsOn": [
                                "red"
                            ],
                            "lightsOff": [
                                "green"
                            ]
                        }
                    },
                    "active": {
                        "frames": 8,
                        "cycle": 0.5,
                        "mode": "loop",
                        "properties": {
                            "lightsOff": [
                                "red"
                            ],
                            "lightsOn": [
                                "green"
                            ]
                        }
